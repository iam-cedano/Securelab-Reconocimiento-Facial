SUPABASE_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/camera-capture
DEVICE_API_TOKEN=replace-with-a-long-random-secret
DEVICE_ID=esp32-cam-01
# Optional Supabase publishable/anon token for the Authorization bearer header.
AUTHORIZATION_TOKEN=
POLL_INTERVAL_SECONDS=5
# Set to true to run one poll cycle and exit instead of waiting for future rows.
RUN_ONCE=
# Optional path mounted into the simulator container. If empty, a tiny test JPEG is used.
PHOTO_FILE=
